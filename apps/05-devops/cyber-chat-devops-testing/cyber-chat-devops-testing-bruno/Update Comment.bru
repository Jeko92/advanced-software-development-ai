meta {
  name: Update Comment
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/comments/{{commentId}}
  body: json
  auth: bearer
}

body:json {
  {
    "body": "Edited: also turn your brightness way down."
  }
}

assert {
  res.status: eq 200
  res.body.author: eq chat_wanderer
}

auth:bearer {
  token: {{accessToken}}
}
