meta {
  name: Create User
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

body:json {
  {
    "username": "packet_sorcerer",
    "password": "hunter2ButBetter"
  }
}

assert {
  res.status: eq 201
  res.body.passwordHash: isUndefined
}

script:post-response {
  bru.setVar("userId", res.body.id);
}

auth:bearer {
  token: {{accessToken}}
}
