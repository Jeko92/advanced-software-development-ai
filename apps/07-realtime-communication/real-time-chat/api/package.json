{
  "name": "@bootcamp/real-time-chat-api",
  "version": "1.0.0",
  "description": "Real-time chat challenge API \u2014 a NestJS gateway on Socket.io delivering messages, presence and typing events per room.",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/websockets": "^11.2.6",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  }
}
