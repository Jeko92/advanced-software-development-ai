{
  "name": "@bootcamp/world-cup-live-match-ticker-api",
  "version": "1.0.0",
  "private": true,
  "description": "World Cup Live Match Ticker challenge API — streams match events over Server-Sent Events, on plain Express.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
