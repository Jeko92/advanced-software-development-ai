meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "chat_wanderer",
    "password": "hunter2ButBetter"
  }
}

assert {
  res.status: eq 201
  res.body.passwordHash: isUndefined
}

script:post-response {
  bru.setVar("authUserId", res.body.id);
}
