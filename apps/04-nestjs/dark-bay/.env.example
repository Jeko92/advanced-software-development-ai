PORT=3000
NODE_ENV=development

# Path to the SQLite database file, relative to the project root.
DB_FILE=data/darkbay.sqlite

# Any long random string; used to sign and verify JWTs.
JWT_SECRET='<a long random secret>'
JWT_EXPIRES_IN=1h

# How many days an auction stays open when no endDate is provided.
DEFAULT_AUCTION_DURATION_DAYS=3

# Optional — bcrypt cost factor for password hashing. Defaults to 12 if unset.
BCRYPT_SALT_ROUNDS=12
