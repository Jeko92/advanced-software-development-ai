PORT=3030
NODE_ENV=development
POSTGRES_HOST_PORT=5433

# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
DATABASE_URL='<Postgres connection string>'

# Optional. Set to "true" only for an external Postgres connection (e.g. from
# outside Render). Leave unset for Render internal connections or local
# docker-compose.
DATABASE_SSL=

# Optional, only relevant when DATABASE_SSL=true. PEM text of the provider's
# CA bundle, used to verify the server certificate.
DATABASE_CA_CERT=

# Optional, only relevant when DATABASE_SSL=true and DATABASE_CA_CERT is not
# set. Set to "true" to skip certificate verification — an explicit,
# deliberate downgrade, not a default.
DATABASE_SSL_INSECURE=

# Any long random string; used to sign and verify JWTs.
JWT_SECRET='<a long random secret>'
JWT_EXPIRES_IN=1h

# How many days an auction stays open when no endDate is provided.
DEFAULT_AUCTION_DURATION_DAYS=3

# Optional — bcrypt cost factor for password hashing. Defaults to 12 if unset.
BCRYPT_SALT_ROUNDS=12
