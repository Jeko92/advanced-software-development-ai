meta {
  name: Create Thread
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/threads
  body: json
  auth: none
}

body:json {
  {
    "title": "Anyone tried rollback-safe deploys yet?",
    "author": "byte_witch",
    "body": "Curious what tooling people use to make prod rollouts less scary."
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("threadId", res.body.id);
}
