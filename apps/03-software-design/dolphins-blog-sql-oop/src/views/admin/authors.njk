{% extends "layouts/_admin-base.njk" %}

{% block main_content %}
  <h1 class="h3 mb-4">Authors</h1>

  {% if error %}
    <div class="alert alert-danger">{{ error }}</div>
  {% endif %}

  <form method="POST" action="/admin/authors" class="row g-2 mb-4">
    <div class="col-auto">
      <input
        type="text"
        class="form-control"
        name="name"
        placeholder="Author name"
        required
      />
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-primary">Add Author</button>
    </div>
  </form>

  {% if authors.length === 0 %}
    <p class="text-muted">No authors yet.</p>
  {% else %}
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Name</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for author in authors %}
          <tr>
            <td>{{ author.name }}</td>
            <td class="text-end">
              <form
                method="POST"
                action="/admin/authors/{{ author.id }}/delete"
                class="d-inline"
                onsubmit="return confirm('Delete this author?');"
              >
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  Delete
                </button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endblock %}
