{% macro renderHeader(post) %}
  <header
    class="masthead"
    style="background-image: url('/assets/img/post-bg/{{ post.image }}')"
  >
    <div class="container position-relative px-4 px-lg-5">
      <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">
          <div class="post-heading">
            <h1>{{ post.title }}</h1>
            {% if post.teaser %}
              <h2 class="subheading">{{ post.teaser }}</h2>
            {% endif %}
            <span class="meta">
              Posted by <a href="#!">{{ post.author }}</a>
              on {{ post.createdAtFormatted or post.createdAt }}
            </span>
          </div>
        </div>
      </div>
    </div>
  </header>
{% endmacro %}

{% macro renderContent(post) %}
  <article class="mb-4">
    <div class="container px-4 px-lg-5">
      <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">{{ post.content | safe }}</div>
      </div>
    </div>
  </article>
{% endmacro %}
