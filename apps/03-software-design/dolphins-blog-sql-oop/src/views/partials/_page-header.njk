<!-- Page Header-->
<header
  class="masthead {{ pageClass }}"
  style="background-image: url('{{ headerImage | default('/assets/img/home-bg.jpg') }}');"
>
  <div class="container position-relative px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-md-10 col-lg-8 col-xl-7">
        <div class="site-heading">
          <h1>{{ headerTitle | default('🐬 Clean Blog 🐬') }}</h1>
          <span class="subheading"
            >{{ headerSubtitle | default('Practicing express, nunjucks, MVC Pattern and co') }}</span
          >
        </div>
      </div>
    </div>
  </div>
</header>
