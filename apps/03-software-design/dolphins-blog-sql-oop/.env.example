PORT=3000
PAGE_SIZE=2

# Path to the SQLite file, relative to the project root (or absolute).
# The file and its parent directory are created automatically on first
# connect — nothing here needs to exist or be checked into the repo.
DB_PATH=db/blog.db

# Rudimentary admin auth (see challenges.md #4) — required, no insecure default.
ADMIN_USER=admin
ADMIN_PASS=

# Secret used to sign the admin session cookie so it can't be forged by
# just setting `admin=true` from the browser. Required, no insecure default.
COOKIE_SECRET=