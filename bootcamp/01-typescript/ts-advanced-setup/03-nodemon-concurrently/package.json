{
  "name": "@bootcamp/nodemon-concurrently-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal demo for TypeScript Advanced Setup: nodemon + concurrently",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run build && concurrently \"pnpm run build:watch\" \"pnpm run start:dev\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start:dev": "nodemon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  },
  "prettier": "@bootcamp/prettier-config"
}
