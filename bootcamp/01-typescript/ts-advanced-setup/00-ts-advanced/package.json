{
  "name": "@bootcamp/ts-advanced-demo",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:watch": "tsc --watch",
    "start:dev": "nodemon",
    "start:concurrently": "concurrently \"pnpm run build:watch\" \"pnpm run start:dev\"",
    "start:tsx": "tsx --watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "http-server": "14.1.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
