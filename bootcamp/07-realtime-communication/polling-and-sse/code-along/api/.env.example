PORT=3001
CORS_ORIGIN=http://localhost:3000

# For native (non-Docker) `pnpm dev` — points at the `db` service published
# on POSTGRES_HOST_PORT from ../.env (defaults to 5434). Inside
# docker-compose, the api container instead gets a DATABASE_URL pointing at
# db:5432 directly (see ../docker-compose.yml) — service-name resolution
# only works between containers, never from your host machine.
DATABASE_URL=postgresql://polling_sse:polling_sse@localhost:5434/polling_sse
