# Used by docker-compose.yml to configure and connect the `db` service.
POSTGRES_HOST_PORT=5434
DB_USER=polling_sse
DB_PASSWORD=polling_sse
DB_NAME=polling_sse

# The browser's origin, allowed by the api's CORS config.
CORS_ORIGIN=http://localhost:3000

# The browser calls the api directly at its published host port — never the
# internal `api` service name, which only resolves between containers.
NEXT_PUBLIC_API_URL=http://localhost:3030
