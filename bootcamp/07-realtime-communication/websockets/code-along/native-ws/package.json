{
  "name": "@bootcamp/websockets-native-ws",
  "version": "1.0.0",
  "description": "WebSockets code-along raw server — an Express app with the low-level ws library attached, relaying messages to every connected client.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "globals": "^17.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
