meta {
  name: Add Comment To Thread
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/threads/{{threadId}}/comments
  body: json
  auth: bearer
}

body:json {
  {
    "body": "Try a low-blue-light theme too, helps more than font choice."
  }
}

assert {
  res.status: eq 201
  res.body.author: eq chat_wanderer
  res.body.authorId: isDefined
}

script:post-response {
  bru.setVar("commentId", res.body.id);
}

auth:bearer {
  token: {{accessToken}}
}
