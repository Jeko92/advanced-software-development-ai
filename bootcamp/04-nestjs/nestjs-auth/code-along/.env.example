PORT=<Declare app port here>
DB_FILE=<Declare sqlite database file path here, e.g. data/cyber-chat.sqlite>
JWT_SECRET=<Long random string used to sign/verify JWTs, e.g. `openssl rand -base64 32` — never commit the real value>
SESSION_SECRET=<Long random string used as express-session's secret, e.g. `openssl rand -base64 32` — never commit the real value>
BCRYPT_SALT_ROUNDS=<Optional. bcrypt cost factor for hashing passwords/API keys. Defaults to 12 if unset.>
GOOGLE_CLIENT_ID=<Google OAuth client ID from Google Cloud Console credentials — never commit the real value>
GOOGLE_CLIENT_SECRET=<Google OAuth client secret from Google Cloud Console credentials — never commit the real value>
GOOGLE_CALLBACK_URL=<Google OAuth callback URL, e.g. http://localhost:3000/auth/google/callback>
GITHUB_CLIENT_ID=<GitHub OAuth App client ID — never commit the real value>
GITHUB_CLIENT_SECRET=<GitHub OAuth App client secret — never commit the real value>
GITHUB_CALLBACK_URL=<GitHub OAuth callback URL, e.g. http://localhost:3000/auth/github/callback>
