meta {
  name: Create Quote (JWT) GitHub
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/quotes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "quote": "GITHUB:-Simplicity is the soul of efficiency.",
    "author": "GITHUB:-Austin Freeman"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("quoteId", res.body.id);
}
