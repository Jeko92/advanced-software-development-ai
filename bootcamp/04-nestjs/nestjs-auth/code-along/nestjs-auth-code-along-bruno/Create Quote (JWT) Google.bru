meta {
  name: Create Quote (JWT) Google
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/quotes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "quote": "GOOGLE:-Simplicity is the soul of efficiency.",
    "author": "GOOGLE:-Austin Freeman"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("quoteId", res.body.id);
}
