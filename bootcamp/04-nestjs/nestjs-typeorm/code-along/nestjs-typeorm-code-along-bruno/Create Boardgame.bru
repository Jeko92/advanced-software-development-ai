meta {
  name: Create Boardgame
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/boardgame
  body: json
  auth: none
}

body:json {
  {
    "name": "Azul",
    "minPlayers": 2,
    "maxPlayers": 4,
    "playtimeMinutes": 45,
    "complexity": 1.8
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("boardgameId", res.body.id);
}
