    "express": "^5.2.1",
    "nunjucks": "^3.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "prettier-plugin-jinja-template": "^2.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nunjucks": "^3.2.6",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "globals": "^17.0.0"
