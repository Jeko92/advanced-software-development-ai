{
  "name": "@bootcamp/nestjs-basics-2-code-along",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest --env-file=.env start --watch",
    "start:debug": "nest start --env-file=.env --debug --watch",
