{
  "name": "@bootcamp/devops-docker-advanced-scoreboard-service-multi-stage",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "docker:dev": "docker compose --env-file .env.development -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:dev:down": "docker compose --env-file .env.development -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:dev:reset": "docker volume rm scoreboard-service_postgres_dev_data",
    "docker:prod": "docker compose up",
    "docker:prod:down": "docker compose down"
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
