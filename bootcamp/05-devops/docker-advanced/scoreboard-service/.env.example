DB_USER='<Postgres username, e.g. arcade-master>'
DB_PASSWORD='<Postgres password>'
# For `docker run --env-file .env` against arcade-net, use the container
# name (e.g. arcade-db). Compose ignores this and hardcodes DB_HOST=db.
DB_HOST='<Database hostname>'
DB_PORT='<Postgres port, e.g. 5432>'
DB_NAME='<Database name, e.g. postgres>'
PORT='<Host port docker compose publishes the scoreboard on, e.g. 3000>'
