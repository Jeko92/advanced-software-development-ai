{
  "name": "@bootcamp/devops-testing-code-along",
  "version": "1.0.0",
  "description": "Hands-on sandbox for the DevOps Testing handouts: Vitest fundamentals, TDD, and NestJS unit/integration/e2e testing.",
  "type": "module",
  "scripts": {
    "dev": "../../code-along/node_modules/.bin/nest --env-file=.env start --watch",
    "build": "../../code-along/node_modules/.bin/nest build",
    "start": "../../code-along/node_modules/.bin/nest start",
    "start:prod": "node --env-file=.env dist/main",
    "lint": "eslint ../../code-along",
    "lint:fix": "eslint ../../code-along --fix",
    "typecheck": "../../code-along/node_modules/.bin/tsc --noEmit",
    "format:check": "../../code-along/node_modules/.bin/prettier --check .",
    "format:write": "../../code-along/node_modules/.bin/prettier --write .",
    "test": "../../code-along/node_modules/.bin/vitest run",
    "test:watch": "../../code-along/node_modules/.bin/vitest",
    "test:e2e": "../../code-along/node_modules/.bin/vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "../../code-along/node_modules/.bin/vitest --config vitest.config.e2e.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/typeorm": "^11.0.3",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
