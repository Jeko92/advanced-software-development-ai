# Copy to .env and adjust. Every value below has a development default,
# so the API also runs with no .env at all.

PORT=3000

# SQLite file, created on first startup.
DATABASE_PATH=darkbay.sqlite

# Signing key for JWTs. Change this anywhere real: anyone holding it can
# mint a valid token for any account.
JWT_SECRET=dev-only-secret-change-me

# Accepts zeit/ms notation: 60s, 15m, 7d.
JWT_EXPIRES_IN=1d
