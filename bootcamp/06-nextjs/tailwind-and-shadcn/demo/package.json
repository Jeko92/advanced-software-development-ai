{
  "name": "@bootcamp/nextjs-tailwind-and-shadcn-demo",
  "version": "1.0.0",
  "description": "Coffee Nerds — a Next.js demo for the Tailwind & shadcn/ui chapter: styling app-router pages with Tailwind CSS and shadcn/ui components over a TypeORM-backed Postgres menu/category service.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "db:seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0"
  }
}
