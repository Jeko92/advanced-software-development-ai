# Used by compose.yaml to configure the `db` service, and by
# src/db/data-source.ts if/when the menu service is wired up to it (see
# README for the current, mocked state of this demo).
#
# DATABASE_PORT is the host-side port docker-compose maps to the
# container's internal 5432. It's set to 5433 by default because a
# native Postgres install commonly already occupies 5432 on dev
# machines; change it if 5433 is unavailable on yours.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=<postgres user>
DATABASE_PASSWORD=<postgres password>
DATABASE_NAME=<database name>
