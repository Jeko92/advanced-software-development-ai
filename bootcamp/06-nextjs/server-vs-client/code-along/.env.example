NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used by docker-compose.yml to configure and connect to the `db` service.
# DB_HOST must be 'db' (the compose service name) when the app runs inside
# Docker; use 'localhost' instead if connecting from your host machine.
DB_USER=<postgres user>
DB_PASSWORD=<postgres password>
DB_HOST=db
DB_PORT=5432
DB_NAME=<database name>

AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
