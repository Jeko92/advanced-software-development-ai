{
  "name": "@bootcamp/backend-sql-advanced",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "db:seed": "sqlite3 \"${DB_PATH:-db/blog.db}\" < db/seeddb.sql",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "express": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@bootcamp/eslint-config": "workspace:*",
    "@bootcamp/prettier-config": "workspace:*",
    "@bootcamp/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-embed": "^0.5.1"
  }
}
